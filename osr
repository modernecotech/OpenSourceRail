#!/usr/bin/env bash
# Stable launcher for the user-local toolchain installed by ./install.sh.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_VERSION="22.23.2"
TOOL_ROOT="${HOME}/.local/share/opensource-rail/toolchains"
export PATH="$ROOT/.venv/bin:$TOOL_ROOT/bin:$TOOL_ROOT/node-v$NODE_VERSION/bin:${HOME}/.cargo/bin:$PATH"
export PLAYWRIGHT_BROWSERS_PATH="$TOOL_ROOT/playwright"
cd "$ROOT"

usage() {
    cat <<'EOF'
Usage: ./osr [COMMAND] [arguments]

  (no command)       Show ferrite-PM maglev development status
  workbench          Open the design UI at 127.0.0.1:8090
  infrastructure ... Run/check the primary infrastructure study
  design [action]    Build, run, check, verify, status or release-check
  sim [city] ...     Replay city energy/charging (Baghdad default)
  city <slug>        Generate formation, service, charging and cost planning
  build              Rebuild native kits, replays, cities and design report
  book [arguments]   Rebuild OpenSourceRail-Book.pdf
  test               Verify Rust, Python, configuration and browser results
  capabilities ...   Generate/check the capability directory
  catalogue ...      Index, plan or regenerate selected cities
  readiness [...]    Show source-bound readiness and outstanding gates
  assurance ...      Run/publish/verify engineering, lifecycle or formal profiles
EOF
}

command_name="${1:-infrastructure}"
if (( $# == 0 )); then
    set -- infrastructure status
fi
(( $# == 0 )) || shift

case "$command_name" in
    infrastructure|design)
        exec tools/automation/osr-python tools/automation/ferrite-maglev-study.py "$@"
        ;;
    readiness)
        exec tools/automation/osr-python tools/automation/ferrite-maglev-study.py readiness "$@"
        ;;
    assurance)
        exec tools/automation/osr-python -m engineering.ferrite_maglev.pilot_assurance "$@"
        ;;
    workbench)
        exec npm run workbench -- "$@"
        ;;
    sim)
        if (( $# == 0 )); then set -- baghdad; fi
        exec tools/automation/osr-python -m engineering.ferrite_maglev.cities --simulate "$@"
        ;;
    city)
        exec tools/automation/osr-python -m engineering.ferrite_maglev.cities "$@"
        ;;
    build)
        (( $# == 0 )) || { printf 'usage: ./osr build\n' >&2; exit 2; }
        cargo build --locked -p osr-maglev-control --examples
        exec tools/automation/osr-python tools/automation/ferrite-maglev-study.py build
        ;;
    book)
        exec tools/automation/osr-python tools/automation/build-doc-book.py "$@"
        ;;
    capabilities|catalogue)
        exec tools/automation/osr-python "tools/automation/$command_name.py" "$@"
        ;;
    test)
        (( $# == 0 )) || { printf 'usage: ./osr test\n' >&2; exit 2; }
        exec bash tools/automation/test-maglev.sh
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        printf 'osr: unknown command: %s\n\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac
