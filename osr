#!/usr/bin/env bash
# Stable launcher for the user-local toolchain installed by ./install.sh.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_VERSION="22.23.2"
TOOL_ROOT="${HOME}/.local/share/opensource-rail/toolchains"
export PATH="$ROOT/.venv/bin:$TOOL_ROOT/bin:$TOOL_ROOT/node-v$NODE_VERSION/bin:${HOME}/.cargo/bin:$PATH"
export PLAYWRIGHT_BROWSERS_PATH="$TOOL_ROOT/playwright"
cd "$ROOT"

usage() {
    cat <<'EOF'
Usage: ./osr [COMMAND] [arguments]

  (no command)       Show the v0.5 primary ferrite-maglev development status
  workbench          Open the primary maglev design UI at 127.0.0.1:8090
  workbench legacy   Build/run the retained wheel/rail platform GUI
  infrastructure ... Run/check the primary ferrite-maglev infrastructure study
  design [action]    Primary maglev build, run, check, verify, status or release-check
  design legacy ...  Explicit v0.4 wheel/rail compiler and engineering workflows
  sim [city] ...     Replay primary maglev city energy/charging (Baghdad default)
  sim legacy ...     Run the retained wheel/rail simulator
  city <slug>        Compile primary maglev formation/service/charging/cost planning
  city legacy <slug> Regenerate an explicit wheel/rail comparator city
  build              Rebuild stale native kits, replays, all cities and primary report
  build legacy       Build the retained full wheel/rail comparator payload
  book [arguments]   Rebuild the primary maglev OpenSourceRail-Book.pdf
  book legacy ...    Build the retained wheel/rail reader edition
  test               Run Rust, Python, browser, and repository checks
  validate ...       Run/plan/verify local checks with source-bound receipts
  doctor ...         Inspect a named local toolchain profile without installing
  capabilities ...   Generate/check the retained capability and source directory
  catalogue ...      Index retained payloads or plan/run only selected cities
  check --scope ...  Run selected local verification tiers or plan source impact
  engineering ...    Run an engineering-toolchain command
  example-city ...   Run/manage the isolated complete-city acceptance scenario
  readiness [...]    Audit all city ERP, component and supervision inputs
  supervision ...    Generate and operate FUXA, telemetry and lifecycle integration
  erp ...            Manage ERPNext business operations (init/build/up/setup/status/bench)
EOF
}

command_name="${1:-infrastructure}"
if (( $# == 0 )); then
    set -- infrastructure status
fi
(( $# == 0 )) || shift

case "$command_name" in
    infrastructure)
        exec tools/automation/osr-python tools/automation/ferrite-maglev-study.py "$@"
        ;;
    example-city)
        exec python3 tools/automation/city-e2e.py "$@"
        ;;
    readiness)
        exec python3 tools/automation/operating-readiness.py "$@"
        ;;
    supervision)
        exec python3 tools/automation/supervision.py "$@"
        ;;
    erp)
        if [[ "${1:-}" == "components" ]]; then
            shift
            exec python3 tools/automation/erp-components.py "$@"
        fi
        if [[ "${1:-}" == "city" ]]; then
            shift
            exec python3 tools/automation/erpnext-city.py "$@"
        fi
        exec python3 tools/automation/erp-platform.py "$@"
        ;;
    workbench)
        if [[ "${1:-}" == legacy ]]; then
            shift
            exec npm run workbench:legacy -- "$@"
        fi
        exec npm run workbench -- "$@"
        ;;
    sim)
        if [[ "${1:-}" != legacy ]]; then
            if (( $# == 0 )); then set -- baghdad; fi
            exec tools/automation/osr-python -m engineering.ferrite_maglev.cities --simulate "$@"
        fi
        shift
        exec cargo run --release --bin osr-sim -- "$@"
        ;;
    design)
        if [[ "${1:-}" != legacy ]]; then
            exec tools/automation/osr-python tools/automation/ferrite-maglev-study.py "$@"
        fi
        shift
        case "${1:-}" in
            twin)
                shift
                exec tools/automation/osr-python tools/automation/design-digital-thread.py "$@"
                ;;
            campaign)
                shift
                exec tools/automation/osr-python tools/automation/generative-design-campaign.py "$@"
                ;;
            problems|run|search|iterate|compare|refine|verify|export|jobs|show|cancel|resume)
                exec tools/automation/osr-python tools/automation/design-engine.py "$@"
                ;;
        esac
        exec cargo run --release --bin osr-design -- "$@"
        ;;
    city)
        if [[ "${1:-}" != legacy ]]; then
            exec tools/automation/osr-python -m engineering.ferrite_maglev.cities "$@"
        fi
        shift
        (( $# == 1 )) || { printf 'usage: ./osr city legacy <slug>\n' >&2; exit 2; }
        exec tools/automation/regenerate-city.sh "$1"
        ;;
    build)
        if [[ "${1:-}" == legacy && $# == 1 ]]; then
            exec tools/automation/build-all.sh
        fi
        (( $# == 0 )) || { printf 'usage: ./osr build [legacy]\n' >&2; exit 2; }
        cargo build -p osr-maglev-control --examples
        exec tools/automation/osr-python tools/automation/ferrite-maglev-study.py build
        ;;
    book)
        if [[ "${1:-}" == legacy ]]; then
            shift
            exec tools/automation/osr-python tools/automation/build-doc-book.py --legacy "$@"
        fi
        exec tools/automation/osr-python tools/automation/build-doc-book.py "$@"
        ;;
    validate)
        exec tools/automation/osr-python tools/automation/local-validation.py "$@"
        ;;
    doctor)
        exec tools/automation/osr-python tools/automation/doctor.py "$@"
        ;;
    capabilities)
        exec tools/automation/osr-python tools/automation/capabilities.py "$@"
        ;;
    catalogue)
        exec tools/automation/osr-python tools/automation/catalogue.py "$@"
        ;;
    check)
        exec tools/automation/osr-python tools/automation/check.py "$@"
        ;;
    test)
        cargo fmt --all -- --check
        cargo clippy --workspace --all-targets -- -D warnings
        cargo test --workspace --all-targets
        tools/automation/osr-python -m pytest -q design/city-generation/tests design/component-catalogue/tests \
            engineering/analysis/tests tools/osr-aln-convert/tests tools/reference-ma/tests tools/automation/tests
        tools/automation/osr-python engineering/subsystem_control_register.py --check
        tools/automation/osr-python engineering/toolchain/baseline_assurance.py --check
        cargo run --quiet -p osr-consensus --bin osr-resilience-evidence -- --check
        cargo run --quiet --release -p osr-sim --bin osr-soak-evidence -- --check
        tools/automation/osr-python tools/automation/component_rfc_readiness.py --check
        tools/automation/osr-python tools/automation/operating-readiness.py --check
        tools/automation/osr-python tools/automation/validate-commercial-partnership.py --check
        tools/automation/osr-python tools/automation/validate-supplier-technical-support.py --check
        tools/automation/osr-python tools/automation/digital-assurance.py --check
        tools/automation/osr-python tools/automation/component_assurance.py --check
        npm run test:frontend
        tools/automation/osr-python tools/automation/audit-project-twins.py
        tools/automation/osr-python tools/automation/validate-host-manifests.py
        tools/automation/osr-python tools/automation/repo-health.py --quiet
        tools/automation/osr-python tools/automation/check-markdown-links.py
        ;;
    engineering)
        exec tools/automation/engineering-toolchain.sh "$@"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        printf 'osr: unknown command: %s\n\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac
