#!/usr/bin/env bash
# Stable launcher for the explicitly selected development design.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_VERSION="22.23.2"
TOOL_ROOT="${HOME}/.local/share/opensource-rail/toolchains"
export PATH="$ROOT/.venv/bin:$TOOL_ROOT/bin:$TOOL_ROOT/node-v$NODE_VERSION/bin:${HOME}/.cargo/bin:$PATH"
export PLAYWRIGHT_BROWSERS_PATH="$TOOL_ROOT/playwright"
cd "$ROOT"
if [[ "${1:-}" == -h || "${1:-}" == --help || "${1:-}" == help ]]; then
    cat <<'EOF'
Usage: ./osr [COMMAND] [arguments]

  (no command)      Show the v0.6 passive-wheel vehicle reference and open propulsion selection
  status/readiness  Show current candidate identities, evidence and open gates
  build [--force]   Regenerate reference engineering; preserve city evaluation holds
  design ...        Current status/build/verify; campaign create/run/compare/publish
  design space ...  Build/verify material, structure, joint and motor research options
  design architecture ... Run/publish/verify whole-railway research families
  design adaptive ...     Plan/run continuing function-first design revisions
  design portfolio ...    Build/verify the breadth-first shape portfolio
  design civil-portfolio ... Compare 20 m civil geometry and delivery scenarios
  design topology ...     Generate/replay civil material-distribution experiments
  design progress ...     Run/replay continuing reference-cell physics and manufacture
  design sourced ...      Generate/replay source-backed hardware and journey alternatives
  design station-cycle ... Stateful capture → storage → controlled relaunch and costs
  design closure ...       Reconciled installed body, civil, counted fleet and 14-scope costs
  design station-pair ... Parts → mass → Rust motion → fleet, civil and cost comparison
  source ...              Offline material/cost review, explicit feed refresh, studies and Workbench
  trip/twin/plan ...      Run retained trip research, inspect the twin or create route proposals
  infrastructure ... Alias for the same selected design
  verify/check      Verify the current source-bound publication
  workbench [...]   Serve the read-only current Workbench on 127.0.0.1:8090
  city [slug]       Inspect retained city geography and its evaluation hold
  gis ...           Export selected cities to native RustGIS projects; install/audit the pinned backend
  plan [...]        Serve, compile and verify a GIS proposal bound to v0.6
  sim [slug]        Report city performance evidence hold (exit status 3)
  catalogue         Read retained city geography and evaluation holds
  trip [...]        Run explicit, source-bound candidate research
  twin [...]        Inspect verified exports for the selected physical candidate
  book [--check]    Build/check the selected-design reader
  test              Run current contracts, publication and browser checks
  cycle             Restartable cached refresh of the current design

The default is a development selection. Physical and operating acceptance remain
open. Source-bound outputs remain tied to their declared candidate and inputs.
EOF
    exit 0
fi
if [[ "${1:-}" == gis ]]; then
    shift
    exec tools/automation/osr-python -m engineering.rustgis "$@"
fi
if [[ "${1:-}" == design && "${2:-}" == closure ]]; then
    shift 2
    exec tools/automation/osr-python -m engineering.railway_closure "$@"
fi
if [[ "${1:-}" == design && "${2:-}" == station-cycle ]]; then
    shift 2
    exec tools/automation/osr-python -m engineering.station_cycle "$@"
fi
if [[ "${1:-}" == design && "${2:-}" == station-pair ]]; then
    shift 2
    exec tools/automation/osr-python -m engineering.station_pair "$@"
fi
if [[ "${1:-}" == source || "${1:-}" == sourcing ]]; then
    shift
    exec tools/automation/osr-python -m engineering.sourcing "$@"
fi
if [[ "${1:-}" == design && "${2:-}" == sourced ]]; then
    shift 2
    if [[ "${1:-}" == serve ]]; then
        exec tools/automation/osr-python tools/automation/sourced-workbench.py "$@"
    fi
    if [[ "${1:-}" == verify-publication || "${1:-}" == verify-geometry ]]; then
        tools/automation/osr-python tools/automation/sourced-archive.py ensure "$ROOT/docs/design-engine/sourced-case" >/dev/null
    fi
    exec tools/automation/osr-python -m engineering.sourced_case.cli "$@"
fi
exec tools/automation/osr-python -m engineering.development_baseline.entrypoint "$@"
