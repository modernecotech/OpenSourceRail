/cities/catalogue/*/*/*/engineering/**/*.log
/cities/catalogue/*/*/*/engineering/**/*.gpkg

# Canonical neutral CAD is compressed and sealed in published packets.
*.step
*.stp
*.FCBak
*.blend1
