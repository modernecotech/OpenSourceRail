# Generated whole-train STEP assemblies can exceed GitHub's 100 MB hard
# limit after detailed CAD passes. Keep them local/regenerable; track the
# smaller component STEP files and FreeCAD review documents instead.
mechanical-py/catalog/rolling_stock/trainset-*.step

# Local scratch media. Canonical media belongs under docs/assets/ and
# can be added explicitly with git add -f if needed.
*.mp4
*.mov
*.webm
