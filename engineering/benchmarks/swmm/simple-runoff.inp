[TITLE]
OpenSourceRail SWMM installation benchmark

[OPTIONS]
FLOW_UNITS           LPS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             01:30:00
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         00:00:30
REPORT_STEP          00:05:00
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

[EVAPORATION]
CONSTANT             0.0
DRY_ONLY             NO

[RAINGAGES]
;;Name   Format      Interval SCF Source
Gage1    INTENSITY   0:05     1.0 TIMESERIES Storm

[SUBCATCHMENTS]
;;Name   RainGage Outlet Area Width Slope Imperv Zero
S1       Gage1    J1     1.0  100   1.0   40     25

[SUBAREAS]
;;Subcatch N-Imperv N-Perv S-Imperv S-Perv PctZero RouteTo
S1         0.01     0.10   0.05     0.05   25      OUTLET

[INFILTRATION]
;;Subcatch MaxRate MinRate Decay DryTime MaxInfil
S1         75      10      4     7       0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     0    2.0      0         0        0

[OUTFALLS]
;;Name Elev Type StageData Gated RouteTo
O1     0    FREE            NO

[CONDUITS]
;;Name From To Length Roughness InOffset OutOffset InitFlow MaxFlow
C1     J1   O1 50     0.013     0        0         0        0

[XSECTIONS]
;;Link Shape    Geom1 Geom2 Geom3 Geom4 Barrels
C1     CIRCULAR 0.5   0     0     0     1

[TIMESERIES]
;;Name Date       Time  Value
Storm  01/01/2020 00:00 0
Storm  01/01/2020 00:05 25
Storm  01/01/2020 00:20 25
Storm  01/01/2020 00:25 0

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[COORDINATES]
J1 0 0
O1 50 0

[POLYGONS]
S1 -10 -10
S1 10 -10
S1 10 10
S1 -10 10
