#10532=IFCTASK('3l5ncxqL5Lvf28aPBYBzd$',$,'Condition and inspect substrate','Verify cured laminate, sealed edges, moisture/temperature limits and defect repair; mask bonds, seals, datums, windows, sensors and electrical earths.',$,'LM3-MFG-030-10',$,'HOLD-POINT',$,.F.,$,#10533,$);
#10533=IFCTASKTIME('LM3-MFG-030-10 planning allowance',$,$,$,'PT1H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#10534=IFCTASK('1KjqZWI8nTPuhdvqLWMZHY',$,'Prepare base finish and cut film','Accept the fully cured corrosion/gelcoat base, make adhesion coupons, and plot/cut the livery film from controlled bay templates. Do not apply film over seals, drains, earths, labels, service lands or unresolved defects.',$,'LM3-MFG-030-20',$,'PLANNED',$,.F.,$,#10535,$);
#10535=IFCTASKTIME('LM3-MFG-030-20 planning allowance',$,$,$,'PT2H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#10536=IFCTASK('1OaBbIQljH$Afpl5_Ly7Yd',$,'Apply livery film and candidate roof coating','Dry-apply and squeegee the selected rail-use film with controlled seams/edges. On qualified exposed-roof zones only, mask all keep-outs and apply the CaCO3 candidate beside retained witness coupons to the released wet/dry-film range.',$,'LM3-MFG-030-30',$,'PLANNED',$,.F.,$,#10537,$);
#10537=IFCTASKTIME('LM3-MFG-030-30 planning allowance',$,$,$,'PT2H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#10538=IFCTASK('1FwNp3FZrNfe_8kSKGv578',$,'Controlled cure','Maintain the film/coating suppliers'' temperature, humidity and ventilation limits; post-heat or edge-treat film only where the selected system requires it, and let the roof coating reach its released cure before handling.',$,'LM3-MFG-030-40',$,'HOLD-POINT',$,.F.,$,#10539,$);
#10539=IFCTASKTIME('LM3-MFG-030-40 planning allowance',$,$,$,'PT10H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#10540=IFCTASK('0VLIP9IA9MchhxA0jFlGXR',$,'Inspect and retain coupons','Inspect bubbles, wrinkles, seams, edges and prohibited-zone masking; record coating thickness/adhesion/cure, colour/gloss and measured solar reflectance/emittance, and retain labelled coupons for UV, abrasion and wash ageing.',$,'LM3-MFG-030-50',$,'HOLD-POINT',$,.F.,$,#10541,$);
#10541=IFCTASKTIME('LM3-MFG-030-50 planning allowance',$,$,$,'PT1H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
