#10345=IFCTASK('0EkZHxjMrLRPNwNw7XBnnE',$,'Bogie marriage and articulation','Lift only at released points, roll accepted bogies into surveyed positions, lower onto interfaces, close body/bogie and articulation joints, and independently witness safety-critical locking.',$,'LM3-MFG-090-20',$,'HOLD-POINT',$,.F.,$,#10346,$);
