#9211=IFCTASK('36Hq9COOjJUw$208oW7d6K',$,'Gauge aperture and dry-fit','Gauge carrier-ring datums and drains, protect glass edges, place the cassette on nonmetallic setting blocks and confirm uniform design clearance without forcing the glass.',$,'LM3-MFG-040-20',$,'HOLD-POINT',$,.F.,$,#9212,$);
