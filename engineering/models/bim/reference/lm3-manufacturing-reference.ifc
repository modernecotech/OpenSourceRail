#10347=IFCTASK('1ze2S3i69QaBlkDDtVayvl',$,'Close trainlines, couplers and remaining fit-out','Connect labelled HV/LV/data/coolant/air paths, install end equipment and remaining service panels, then perform continuity, leak, movement-envelope and access checks.',$,'LM3-MFG-090-30',$,'HOLD-POINT',$,.F.,$,#10348,$);
