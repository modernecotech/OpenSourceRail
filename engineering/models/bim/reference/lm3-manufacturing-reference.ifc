#10349=IFCTASK('0j34pM2wTO_PmKCt8t00Ba',$,'Static systems commissioning','Run brake, door/interlock, lighting, HVAC, battery/HVIL, detection, communications, passenger systems, emergency and degraded-mode procedures against released test scripts.',$,'LM3-MFG-090-40',$,'HOLD-POINT',$,.F.,$,#10350,$);
