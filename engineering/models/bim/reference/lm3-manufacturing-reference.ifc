#9217=IFCTASK('19SH8N3vvPH84IZWKoBxlM',$,'Water and replacement test','Run the controlled spray test, inspect the dry side and drains, then remove/refit the first article with the documented lifting/jacking method and record elapsed replacement time.',$,'LM3-MFG-040-50',$,'HOLD-POINT',$,.F.,$,#9218,$);
