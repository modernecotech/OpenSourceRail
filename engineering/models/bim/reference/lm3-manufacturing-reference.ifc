#7969=IFCTASK('0r0PlBPjrN4Oc7nEScQ29s',$,'Supplier door cassette on locally made four-point adjustable carrier','Supplier and interface freeze, carrier load proof, EN 14752/national evidence as applicable, datum and seal maps, closed-and-locked loop, obstacle detection, emergency release, water test and timed cassette replacement.',$,'LM3-MFG-050',$,'DESIGN-REFERENCE',$,.F.,$,#7970,$);
