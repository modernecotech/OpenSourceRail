#8998=IFCTASK('1nGrncV61LogFmXVUk1EbW',$,'Three-car final assembly, static test and manufacturing release','All child travelers accepted, train mass/geometry/clearance, brake/door/HV/communications/fire-detection tests, software/configuration hashes, static and low-speed test evidence, open NCR review and independent manufacturing release.',$,'LM3-MFG-090',$,'DESIGN-REFERENCE',$,.F.,$,#8999,$);
