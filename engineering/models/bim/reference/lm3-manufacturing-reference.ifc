#3769=IFCTASK('0akLk3OUDKnRfw2CHquNI6',$,'Solar-reflective, high-emittance exterior coating and thermal witness route','Rail fire/smoke compatibility, substrate/primer compatibility, adhesion, weathering, cleanability, colour/glare review and measured new/aged solar reflectance and thermal emittance. No cooling or energy saving may be claimed before vehicle thermal testing.',$,'LM3-MFG-030',$,'DESIGN-REFERENCE',$,.F.,$,#3770,$);
