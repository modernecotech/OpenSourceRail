#8784=IFCTASK('1K5n6w8cfLRxMiWX8Di_Gz',$,'Inspect, clean and release mould','Inspect mould A-surface, split line, vacuum ports and datums; clean with the qualified system and apply the released semi-permanent release process. Record mould and release lots.',$,'LM3-MFG-020-10',$,'HOLD-POINT',$,.F.,$,#8785,$);
