#9517=IFCTASK('00uyH9fvHKY9$Tfc$LfFGF',$,'Prepare floor and pre-cut covering','Verify substrate flatness, dryness and cleanliness; cut labelled floor pieces from controlled CAD templates and preserve access-hatch breaks, coved edges and drainage paths.',$,'LM3-MFG-060-20',$,'PLANNED',$,.F.,$,#9518,$);
#9518=IFCTASKTIME('LM3-MFG-060-20 planning allowance',$,$,$,'PT2H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#9519=IFCTASK('2ZBiurRQnImfxCKEnNEjzu',$,'Bond covering','Condition material, apply only the selected supplier adhesive at specified spread rate/open time, lay without trapped air, roll in both directions and complete released seam/edge treatment.',$,'LM3-MFG-060-30',$,'HOLD-POINT',$,.F.,$,#9520,$);
#9520=IFCTASKTIME('LM3-MFG-060-30 planning allowance',$,$,$,'PT3H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#9521=IFCTASK('0oqhtJFejIOgZg5Fl6bG9s',$,'Install service rails and inserts','Set blind threaded inserts perpendicular with the supplier force-controlled tool and sampled pull checks; gauge OSR-RAIL-42 pitch/alignment and preserve galvanic isolation.',$,'LM3-MFG-060-40',$,'HOLD-POINT',$,.F.,$,#9522,$);
#9522=IFCTASKTIME('LM3-MFG-060-40 planning allowance',$,$,$,'PT3H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#9523=IFCTASK('1oW4ckXBrGkfccJczTyUdB',$,'Mount and proof passenger fixtures','Install seats, handrails and equipment through released saddles/joints; record torque/locking, then proof-load first articles to the approved fixture calculation without using trim as a load path.',$,'LM3-MFG-060-50',$,'HOLD-POINT',$,.F.,$,#9524,$);
#9524=IFCTASKTIME('LM3-MFG-060-50 planning allowance',$,$,$,'PT3H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
