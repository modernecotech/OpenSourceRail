#9890=IFCTASK('1IRvBlIXjL2AWUJkYGRh6E',$,'Apply exterior finish primer or gelcoat','Apply the released UV/fire-compatible finish layer at controlled wet-film thickness. The supplier minimum/maximum overcoat window overrides this planning allowance.',$,'LM3-MFG-020-20',$,'PLANNED',$,.F.,$,#9891,$);
