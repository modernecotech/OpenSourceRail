#8366=IFCTASK('191W9uSi9OLOdg26_0MRfr',$,'Accept frame and supplier kits','Verify bogie frame NDT/datum survey and all serialized motor, gearbox, coupling, wheelset, bearing, brake and suspension evidence before unpacking.',$,'LM3-MFG-070-10',$,'HOLD-POINT',$,.F.,$,#8367,$);
