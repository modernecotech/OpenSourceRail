#8576=IFCTASK('0vH782xdPHU9I4JQmqeY2f',$,'Preassemble and test modules off vehicle','Build lighting, harness, duct, tray and cabinet modules on dedicated boards/rails; record serials, connectors, firmware/configuration and incoming evidence.',$,'LM3-MFG-080-10',$,'HOLD-POINT',$,.F.,$,#8577,$);
#8577=IFCTASKTIME('LM3-MFG-080-10 planning allowance',$,$,$,'PT3H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#8578=IFCTASK('1BuOIpcH1Oxxxl$WtJF5yq',$,'Install rails, trays, ducts and curb seals','Gauge common datums, install isolated rails/trays and supplier-approved seals, protect fire barriers and preserve removable access zones.',$,'LM3-MFG-080-20',$,'PLANNED',$,.F.,$,#8579,$);
#8579=IFCTASKTIME('LM3-MFG-080-20 planning allowance',$,$,$,'PT3H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#8580=IFCTASK('3BHH3BgiDVsQ$1Gd_lgUqG',$,'Install keyed LV/data and segregated HV services','Route pre-terminated looms to released clips and bend radii; keep HV, LV/data and fluids segregated, fit service loops and blanking caps, and prevent field-cut lighting wires.',$,'LM3-MFG-080-30',$,'HOLD-POINT',$,.F.,$,#8581,$);
#8581=IFCTASKTIME('LM3-MFG-080-30 planning allowance',$,$,$,'PT4H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#8582=IFCTASK('2J3sqCuA1GLfNPdrLMUJUi',$,'Install HVAC, batteries and power modules','Use approved lifts and supplier mounting kits; close coolant, drain, bond, service-disconnect and HVIL interfaces under LOTO.',$,'LM3-MFG-080-40',$,'HOLD-POINT',$,.F.,$,#8583,$);
#8583=IFCTASKTIME('LM3-MFG-080-40 planning allowance',$,$,$,'PT3H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#8584=IFCTASK('3O_iNQcmnIwPnEcbavKNXC',$,'Cold commissioning','Complete continuity, insulation, bonding, connector keying, sensor enumeration, pressure/leak and drain-flow tests before energisation.',$,'LM3-MFG-080-50',$,'HOLD-POINT',$,.F.,$,#8585,$);
#8585=IFCTASKTIME('LM3-MFG-080-50 planning allowance',$,$,$,'PT2H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#8586=IFCTASK('1BTe8uM31Sdv$SRCUKpJGR',$,'Functional release','Run lighting lux/emergency tests, HVAC airflow/condensate tests and controlled HVIL/pre-charge checks; attach actual records to the train configuration.',$,'LM3-MFG-080-60',$,'HOLD-POINT',$,.F.,$,#8587,$);
