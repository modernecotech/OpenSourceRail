#10528=IFCTASK('0akLk3OUDKnRfw2CHquNI6',$,'In-mould base finish, applied livery film, and qualified radiative roof-coating route','Base corrosion/fire protection accepted first; then film substrate/adhesion/edge/removal evidence and radiative-coating fire, adhesion, weathering, cleanability, glare and measured new/aged solar reflectance/emittance. No cooling or energy-saving claim before one-car thermal and maintenance trials.',$,'LM3-MFG-030',$,'DESIGN-REFERENCE',$,.F.,$,#10529,$);
#10529=IFCTASKTIME('LM3-MFG-030 planning cycle',$,$,$,'PT16H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
