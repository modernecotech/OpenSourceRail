#11217=IFCTASK('2ZBiurRQnImfxCKEnNEjzu',$,'Bond covering','Condition material, apply only the selected supplier adhesive at specified spread rate/open time, lay without trapped air, roll in both directions and complete released seam/edge treatment.',$,'LM3-MFG-060-30',$,'HOLD-POINT',$,.F.,$,#11218,$);
#11218=IFCTASKTIME('LM3-MFG-060-30 planning allowance',$,$,$,'PT3H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#11219=IFCTASK('0oqhtJFejIOgZg5Fl6bG9s',$,'Install service rails and inserts','Set blind threaded inserts perpendicular with the supplier force-controlled tool and sampled pull checks; gauge OSR-RAIL-42 pitch/alignment and preserve galvanic isolation.',$,'LM3-MFG-060-40',$,'HOLD-POINT',$,.F.,$,#11220,$);
#11220=IFCTASKTIME('LM3-MFG-060-40 planning allowance',$,$,$,'PT3H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#11221=IFCTASK('1oW4ckXBrGkfccJczTyUdB',$,'Mount and proof passenger fixtures','Install seats, handrails and equipment through released saddles/joints; record torque/locking, then proof-load first articles to the approved fixture calculation without using trim as a load path.',$,'LM3-MFG-060-50',$,'HOLD-POINT',$,.F.,$,#11222,$);
