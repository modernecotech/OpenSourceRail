#11467=IFCTASK('0HWqmPtgbJsRLUs6FuCvC8',$,'Supplier traction motor/gearbox integration into locally fabricated powered bogie','Supplier motor/gearbox/wheelset/brake freeze, bogie-frame proof/NDT, mount-load proof, certified fastener/joint schedule, alignment and backlash, lubrication, insulation/bonding, rotation, brake and thermal instrumentation tests.',$,'LM3-MFG-070',$,'DESIGN-REFERENCE',$,.F.,$,#11468,$);
