#9445=IFCTASK('3UVn1qJP1Hm8tszIX6wo3A',$,'Removable floor panels, transport flooring and common passenger-fixture rail','Fire/smoke certificates, substrate moisture/flatness, adhesive batch and open time, seam/edge detail, slip resistance, hatch removal, fixture load calculations and proof samples, PRM/egress gauge and snag/rattle inspection.',$,'LM3-MFG-060',$,'DESIGN-REFERENCE',$,.F.,$,#9446,$);
