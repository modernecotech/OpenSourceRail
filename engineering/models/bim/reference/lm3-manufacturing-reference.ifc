#9515=IFCTASK('1T$lNmrCbMx8wrzJwfKBnM',$,'Dry-build removable floor and service hatches','Gauge floor supports, dry-fit numbered boards/hatches, verify flush joints, edge radii, lift points and uninterrupted access to battery/HV inspection zones.',$,'LM3-MFG-060-10',$,'HOLD-POINT',$,.F.,$,#9516,$);
