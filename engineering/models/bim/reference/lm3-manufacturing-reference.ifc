#11473=IFCTASK('3jFm4vgLvMfO$xTPy2gqC_',$,'Set wheelsets and running gear','Load the controlled bogie stand, install axlebox/suspension/brake kits under supplier instructions and record orientation, clearances, lubrication and safety locking.',$,'LM3-MFG-070-20',$,'HOLD-POINT',$,.F.,$,#11474,$);
#11474=IFCTASKTIME('LM3-MFG-070-20 planning allowance',$,$,$,'PT2H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#11475=IFCTASK('3qBJTFAojG1hfIhTDBaqsS',$,'Install and align motor/gearbox','Use the dedicated alignment fixture; lift from supplier points, set mount shims, coupling/gear mesh and torque link, then close released high-integrity joints with calibrated tools and independent witness.',$,'LM3-MFG-070-30',$,'HOLD-POINT',$,.F.,$,#11476,$);
#11476=IFCTASKTIME('LM3-MFG-070-30 planning allowance',$,$,$,'PT3H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#11477=IFCTASK('0iwrkQlNvKn9p646fzUHGl',$,'Route services and guards','Install bonding, temperature/speed/WSP harnesses, junctions, guards and safety lanyards with released bend radii, movement envelope and service access.',$,'LM3-MFG-070-40',$,'PLANNED',$,.F.,$,#11478,$);
#11478=IFCTASKTIME('LM3-MFG-070-40 planning allowance',$,$,$,'PT1H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#11479=IFCTASK('2azJn7FSjOCBNBMV_YkZ5h',$,'Static rotation, brake and electrical tests','Check free rotation, alignment/backlash, oil level/leaks, brake application/release, insulation resistance, bonding and sensor polarity before powered testing.',$,'LM3-MFG-070-50',$,'HOLD-POINT',$,.F.,$,#11480,$);
#11480=IFCTASKTIME('LM3-MFG-070-50 planning allowance',$,$,$,'PT2H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#11481=IFCTASK('1b_6qMk2XK5h7WHftZhC16',$,'Release and preserve','Record mass/ride-height setup, close inspection covers, apply witness marks and preservation, and quarantine the bogie until vehicle marriage.',$,'LM3-MFG-070-60',$,'HOLD-POINT',$,.F.,$,#11482,$);
