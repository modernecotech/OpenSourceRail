#7695=IFCTASK('1OaBbIQljH$Afpl5_Ly7Yd',$,'Apply reflective/emissive topcoat','Apply the selected light-colour rail topcoat to controlled wet/dry film thickness. Avoid unqualified experimental radiative-cooling chemistry and review glare/visibility with the authority.',$,'LM3-MFG-030-30',$,'PLANNED',$,.F.,$,#7696,$);
