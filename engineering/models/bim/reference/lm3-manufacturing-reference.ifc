#8368=IFCTASK('3jFm4vgLvMfO$xTPy2gqC_',$,'Set wheelsets and running gear','Load the controlled bogie stand, install axlebox/suspension/brake kits under supplier instructions and record orientation, clearances, lubrication and safety locking.',$,'LM3-MFG-070-20',$,'HOLD-POINT',$,.F.,$,#8369,$);
#8369=IFCTASKTIME('LM3-MFG-070-20 planning allowance',$,$,$,'PT2H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#8370=IFCTASK('3qBJTFAojG1hfIhTDBaqsS',$,'Install and align motor/gearbox','Use the dedicated alignment fixture; lift from supplier points, set mount shims, coupling/gear mesh and torque link, then close released high-integrity joints with calibrated tools and independent witness.',$,'LM3-MFG-070-30',$,'HOLD-POINT',$,.F.,$,#8371,$);
#8371=IFCTASKTIME('LM3-MFG-070-30 planning allowance',$,$,$,'PT3H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#8372=IFCTASK('0iwrkQlNvKn9p646fzUHGl',$,'Route services and guards','Install bonding, temperature/speed/WSP harnesses, junctions, guards and safety lanyards with released bend radii, movement envelope and service access.',$,'LM3-MFG-070-40',$,'PLANNED',$,.F.,$,#8373,$);
#8373=IFCTASKTIME('LM3-MFG-070-40 planning allowance',$,$,$,'PT1H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#8374=IFCTASK('2azJn7FSjOCBNBMV_YkZ5h',$,'Static rotation, brake and electrical tests','Check free rotation, alignment/backlash, oil level/leaks, brake application/release, insulation resistance, bonding and sensor polarity before powered testing.',$,'LM3-MFG-070-50',$,'HOLD-POINT',$,.F.,$,#8375,$);
#8375=IFCTASKTIME('LM3-MFG-070-50 planning allowance',$,$,$,'PT2H30M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
