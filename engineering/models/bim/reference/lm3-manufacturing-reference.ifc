#11215=IFCTASK('00uyH9fvHKY9$Tfc$LfFGF',$,'Prepare floor and pre-cut covering','Verify substrate flatness, dryness and cleanliness; cut labelled floor pieces from controlled CAD templates and preserve access-hatch breaks, coved edges and drainage paths.',$,'LM3-MFG-060-20',$,'PLANNED',$,.F.,$,#11216,$);
