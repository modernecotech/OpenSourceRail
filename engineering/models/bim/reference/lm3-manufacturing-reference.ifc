#9004=IFCTASK('0EkZHxjMrLRPNwNw7XBnnE',$,'Bogie marriage and articulation','Lift only at released points, roll accepted bogies into surveyed positions, lower onto interfaces, close body/bogie and articulation joints, and independently witness safety-critical locking.',$,'LM3-MFG-090-20',$,'HOLD-POINT',$,.F.,$,#9005,$);
#9005=IFCTASKTIME('LM3-MFG-090-20 planning allowance',$,$,$,'PT10H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#9006=IFCTASK('1ze2S3i69QaBlkDDtVayvl',$,'Close trainlines, couplers and remaining fit-out','Connect labelled HV/LV/data/coolant/air paths, install end equipment and remaining service panels, then perform continuity, leak, movement-envelope and access checks.',$,'LM3-MFG-090-30',$,'HOLD-POINT',$,.F.,$,#9007,$);
#9007=IFCTASKTIME('LM3-MFG-090-30 planning allowance',$,$,$,'PT8H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#9008=IFCTASK('0j34pM2wTO_PmKCt8t00Ba',$,'Static systems commissioning','Run brake, door/interlock, lighting, HVAC, battery/HVIL, detection, communications, passenger systems, emergency and degraded-mode procedures against released test scripts.',$,'LM3-MFG-090-40',$,'HOLD-POINT',$,.F.,$,#9009,$);
