#9215=IFCTASK('2_KnRcoyvHxxxSmaxJBsOg',$,'Verify compression, drains and services','Measure seal compression at the released witness points; confirm drain continuity, secondary retention, electrical isolation and heater continuity where fitted.',$,'LM3-MFG-040-40',$,'HOLD-POINT',$,.F.,$,#9216,$);
