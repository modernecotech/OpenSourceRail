#7973=IFCTASK('0N14FBI_LR6BJy7i5yO7pt',$,'Accept supplier cassette and portal','Verify serial/revision/evidence, inspect seals/leaf/drive and gauge the locally made portal and four carrier datums before lifting the cassette.',$,'LM3-MFG-050-10',$,'HOLD-POINT',$,.F.,$,#7974,$);
#7974=IFCTASKTIME('LM3-MFG-050-10 planning allowance',$,$,$,'PT45M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#7975=IFCTASK('01DhuY6UjKwehPcXXkY46u',$,'Lift, pin and adjust carrier','Use the approved lift points; engage datum pins, install four carrier shoes and adjust only within their released range to achieve leaf/aperture geometry without distorting the cassette.',$,'LM3-MFG-050-20',$,'HOLD-POINT',$,.F.,$,#7976,$);
#7976=IFCTASKTIME('LM3-MFG-050-20 planning allowance',$,$,$,'PT1H15M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#7977=IFCTASK('3G8P5K7PPG8BfkS4_rV7z9',$,'Join, seal and connect','Install sealed fasteners to the controlled joint schedule, fit the keyed replaceable seal and connector, retain service loops and record final adjuster positions and witness marks.',$,'LM3-MFG-050-30',$,'PLANNED',$,.F.,$,#7978,$);
#7978=IFCTASKTIME('LM3-MFG-050-30 planning allowance',$,$,$,'PT1H',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#7979=IFCTASK('3ibi_9CePJk9_aJNAuUAHO',$,'Static functional and safety tests','Test open/close cycles, obstruction detection, closed-and-locked circuit, traction interlock, emergency release, local isolation and degraded/manual operation under the supplier procedure.',$,'LM3-MFG-050-40',$,'HOLD-POINT',$,.F.,$,#7980,$);
#7980=IFCTASKTIME('LM3-MFG-050-40 planning allowance',$,$,$,'PT1H15M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
#7981=IFCTASK('0eM9G_Q3DTZhtP6XRd2TE0',$,'Ingress and replacement demonstration','Run the controlled water test and first-article removal/refit; repeat safety tests after replacement and record time, tooling and adjustments.',$,'LM3-MFG-050-50',$,'HOLD-POINT',$,.F.,$,#7982,$);
#7982=IFCTASKTIME('LM3-MFG-050-50 planning allowance',$,$,$,'PT45M',$,$,$,$,$,$,$,$,$,$,$,$,$,$,$);
