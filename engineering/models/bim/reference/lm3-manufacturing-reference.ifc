#9213=IFCTASK('2sx_xj7wXRuPHryuGKuNX0',$,'Install dry seal and pressure frame','Fit the one-piece keyed seal without stretch, lubricants or unapproved sealant; install the pressure frame and tighten captive fasteners in the released cross-pattern to the joint schedule.',$,'LM3-MFG-040-30',$,'PLANNED',$,.F.,$,#9214,$);
