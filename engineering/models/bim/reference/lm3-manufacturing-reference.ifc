#9209=IFCTASK('38e$BcsxbQSwaf4BQ3LJcE',$,'Receive and inspect cassette','Confirm pane/cassette identity and orientation; inspect laminate, edges, frame bond and heater terminals. Quarantine any edge impact, delamination or expired adhesive evidence.',$,'LM3-MFG-040-10',$,'HOLD-POINT',$,.F.,$,#9210,$);
