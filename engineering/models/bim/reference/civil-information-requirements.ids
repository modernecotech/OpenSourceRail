                    <name>
                        <simpleValue>TemplateType</simpleValue>
                    </name>
                </attribute>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>ApplicableEntity</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="OSR template fields declare native property or quantity types" ifcVersion="IFC4X3_ADD2" identifier="OSR-IDS-PROP-TEMPLATE-001" description="Each field in the embedded OSR dictionaries has a stable name and IfcSimplePropertyTemplate type." instructions="Use the declared single-value measure or quantity template type when editing the associated property and quantity sets.">
