                    <name>
                        <simpleValue>Description</simpleValue>
                    </name>
                </attribute>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>ConstraintGrade</simpleValue>
                    </name>
                </attribute>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>ConstraintSource</simpleValue>
