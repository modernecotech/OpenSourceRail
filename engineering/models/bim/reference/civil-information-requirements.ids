        </specification>
        <specification name="Civil planning rates use a native IFC schedule of rates" ifcVersion="IFC4X3_ADD2" identifier="OSR-IDS-COST-SCHEDULE-001" description="The generated cost contract is exposed as a schedule of unit rates, not a bill, tender, quotation, or project estimate.">
