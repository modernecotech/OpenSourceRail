<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>OSR IFC4.3 LM3 information requirements</title>
        <version>1.0</version>
        <description>Machine-checkable product, provenance and mechanical-interface requirements for the LM3 design-reference exchange. Passing is not fabrication release.</description>
        <date>2026-09-27</date>
        <purpose>Rolling-stock BIM product and mechanical-interface delivery</purpose>
        <milestone>Design reference</milestone>
    </info>
    <specifications>
        <specification name="LM3 exchange declares provenance and release boundary" ifcVersion="IFC4X3_ADD2" identifier="OSR-IDS-LM3-PROV-001" description="The exchange identifies its controlled sources and design-reference maturity." instructions="Reject an exchange whose source hash or release boundary is absent.">
            <applicability minOccurs="1" maxOccurs="1">
                <entity>
                    <name>
                        <simpleValue>IFCPROJECT</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>OSR_ManufacturingReference</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Status</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>design-reference-not-released</simpleValue>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>OSR_ManufacturingReference</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ReleaseBoundary</simpleValue>
                    </baseName>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>OSR_DesignDetailRegister</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Source</simpleValue>
                    </baseName>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>OSR_DesignDetailRegister</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>SourceSha256</simpleValue>
                    </baseName>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>OSR_DesignDetailRegister</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>MechanicalInterfaceCount</simpleValue>
                    </baseName>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>OSR_DesignDetailRegister</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>RouteCompatibilityGateCount</simpleValue>
                    </baseName>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>OSR_DesignDetailRegister</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ReleaseBoundary</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
