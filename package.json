{
  "name": "opensourcerail-workbench",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "workbench": "tools/automation/osr-python tools/automation/default-design-workbench.py --port 8090",
    "frontend:build": "tools/automation/osr-python tools/automation/default-design.py build",
    "test:frontend": "node tools/automation/tests/verify-development-baseline.mjs",
    "format:design": "prettier --write \"engineering/development_baseline/web/*.{js,css,html}\"",
    "format:design:check": "prettier --check \"engineering/development_baseline/web/*.{js,css,html}\""
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "3.9.10"
  }
}
