{
  "name": "opensourcerail-frontend-acceptance",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "frontend:build": "bash tools/automation/build-web-frontends.sh",
    "workbench": "npm run frontend:build && python3 tools/automation/workbench-server.py --port 8090",
    "test:frontend": "npm run test:frontend:unit && npm run frontend:build && playwright test",
    "test:frontend:unit": "node --test tests/frontend-unit/*.test.mjs",
    "test:frontend:quick": "playwright test tests/frontend/browser-surfaces.spec.mjs",
    "format:design": "prettier --write \"docs/design-engine/{app.js,app.css,index.html,assembly-inspector.js,engineering-inputs.js,input-revisions.js,scope-controls.js,operation-preflight.js}\" \"tests/frontend-unit/design-guided-inputs.test.mjs\" \"tests/frontend/design-guided-inputs.spec.mjs\"",
    "format:design:check": "prettier --check \"docs/design-engine/{app.js,app.css,index.html,assembly-inspector.js,engineering-inputs.js,input-revisions.js,scope-controls.js,operation-preflight.js}\" \"tests/frontend-unit/design-guided-inputs.test.mjs\" \"tests/frontend/design-guided-inputs.spec.mjs\"",
    "test:frontend:matrix": "playwright test --config playwright.matrix.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "3.9.10"
  }
}
