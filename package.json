{
  "name": "opensourcerail-maglev-workbench",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "workbench": "tools/automation/osr-python tools/automation/maglev-workbench.py --port 8090",
    "frontend:build": "tools/automation/osr-python tools/automation/ferrite-maglev-study.py run",
    "test:frontend": "node tools/automation/tests/verify-maglev-v05.mjs build/maglev-test-browser && node tools/automation/tests/verify-maglev-workbench.mjs build/maglev-test-workbench-browser",
    "format:design": "prettier --write \"docs/workbench/maglev/*.{js,css,html}\"",
    "format:design:check": "prettier --check \"docs/workbench/maglev/*.{js,css,html}\""
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "3.9.10"
  }
}
